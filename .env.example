# Copy to .env.local for local development. In production set these in
# Vercel > Project > Settings > Environment Variables. Never commit real values.

# ---- Admin dashboard sign-in ----
# The SUPER ADMINS: they manage everyone else from the dashboard and cannot be removed or locked
# out there. Other admins are added in the dashboard (Admins & activity > Add admin, invite links).
# One numbered set per super admin (ADMIN_1_* up to ADMIN_9_*): password hash + authenticator app
# secret (two-step sign-in is required) + hashes of their one-time backup codes.
# Make them with:  node scripts/admin-account.mjs   (never type these by hand)
ADMIN_1_EMAIL=
ADMIN_1_PASSWORD_HASH=
ADMIN_1_TOTP_SECRET=
ADMIN_1_BACKUP_CODES=
# Signs the session cookie for everyone. At least 32 random characters (the script prints one).
# Changing it signs everyone out.
ADMIN_SESSION_SECRET=
# Seals (encrypts and tamper-proofs) the admins kept in the database. 32 random bytes in
# base64url (the script prints one). Set it once: changing it means every admin added from
# the dashboard has to be invited again.
ADMIN_DATA_KEY=
# Sign-in also needs the Redis database below: sessions, attempt limits and the activity log live
# there. On Vercel without it, sign-in is switched off.

# ---- Where the dashboard saves events, flavors and fundraisers ----
# Local development needs nothing: files are written to .data/ (git-ignored).
# On Vercel, add an Upstash Redis database (Storage tab); it sets these two for you.
# Without them the live site shows the built-in lists and the dashboard cannot save.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Shopify checkout (optional) ----
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# ---- Shopify: let the dashboard change products (optional) ----
# A PRIVATE key that can change the store. Server only: never prefix with NEXT_PUBLIC_.
# Scopes: read_products, write_products, read_publications, write_publications,
#         read_inventory, write_inventory
# Either a custom app's Admin API access token ...
SHOPIFY_ADMIN_ACCESS_TOKEN=
# ... or a Dev Dashboard app's id and secret (the store must be in the same organization).
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
