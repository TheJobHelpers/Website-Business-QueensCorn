# Copy to .env.local for local development. In production set these in
# Vercel > Project > Settings > Environment Variables. Never commit real values.

# ---- Admin dashboard sign-in (all three required; without them sign-in is switched off) ----
ADMIN_EMAIL=
# At least 12 characters. Or leave ADMIN_PASSWORD empty and set ADMIN_PASSWORD_HASH instead
# (run: node scripts/hash-password.mjs), so the password itself is not stored anywhere.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
ADMIN_SESSION_SECRET=

# ---- Where the dashboard saves events, flavors and fundraisers ----
# Local development needs nothing: files are written to .data/ (git-ignored).
# On Vercel, add an Upstash Redis database (Storage tab); it sets these two for you.
# Without them the live site shows the built-in lists and the dashboard cannot save.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Shopify checkout (optional) ----
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
